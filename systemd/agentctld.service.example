[Unit]
Description=agentctld - host-side deployment control plane
Documentation=https://github.com/simons-agent-space/agentctl
# agentctld talks to the Docker daemon over /var/run/docker.sock and
# to GitHub over HTTPS for `git fetch origin/main`. docker.service is
# an ordering dependency (the socket must exist by the time the
# daemon serves requests) but NOT a requirement dependency: a
# degraded docker daemon must not take down agentctld, because the
# daemon still serves health checks, app listings, inspect, and
# state reads without it. network-online is only a soft ordering
# dependency so a transient network hiccup does not delay startup
# indefinitely.
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple

# Run as a dedicated unprivileged user. Every directory the daemon
# writes to (sources, state, data, caddy fragments, audit log, socket)
# is owned by this user so the daemon's own writes are unprivileged.
# The operator creates the system account with:
#
#   useradd --system --no-create-home --shell /usr/sbin/nologin agentctld
#
# agentctld is intentionally NOT in /etc/sudoers. If a future
# operator task needs elevated privileges, it must be modelled as a
# separate service.
User=agentctld
Group=agentctld

# /var/run/docker.sock is owned by root:docker with mode 0660.
# Adding agentctld to the docker group grants the daemon CLI access
# to the socket so `docker build`, `docker run`, `docker inspect`,
# etc. can talk to the docker daemon. The docker daemon itself runs
# under its own systemd unit (docker.service) with its own
# privileges; agentctld does NOT need mount/unshare/CAP_SYS_ADMIN
# because every privileged operation happens inside dockerd, not
# inside agentctld or its direct children.
#
# Security implication: anyone with code execution as agentctld can
# talk to the Docker daemon. The daemon only invokes Docker with
# a fixed argv built from validated inputs (see docs/DEPLOYMENT.md),
# so a UDS-socket-only attacker cannot escalate via Docker
# arguments. The supplementary group is required for the daemon to
# function; it does not by itself grant new capabilities.
SupplementaryGroups=docker

ExecStart=/usr/local/bin/agentctld

# EnvironmentFile is the single configuration surface. The default
# location is /etc/agentctld/agentctld.env (ConfigurationDirectory).
# Every AGENTCTLD_* variable documented in cmd/agentctld/main.go is
# settable here; unknown variables are passed through to the
# environment and ignored by the daemon. Operators must not commit
# the populated env file.
EnvironmentFile=/etc/agentctld/agentctld.env

Restart=on-failure
RestartSec=5s

# TimeoutStopSec must be strictly greater than the daemon's
# AGENTCTLD_OPERATION_TIMEOUT + AGENTCTLD_WRITE_TIMEOUT_MARGIN, which
# together drive the HTTP WriteTimeout. The daemon's deploy and
# rollback handlers run on a background context bounded by
# AGENTCTLD_OPERATION_TIMEOUT (default 30m); the response write
# happens inside the HTTP WriteTimeout (default 30m + 5m = 35m).
# 40m gives a 5m buffer over the defaults.
#
# If AGENTCTLD_OPERATION_TIMEOUT or AGENTCTLD_WRITE_TIMEOUT_MARGIN
# are raised, raise TimeoutStopSec accordingly so systemd does not
# SIGKILL an active deployment before graceful shutdown completes.
# See docs/AGENTCTLD_INSTALL.md#timeouts for the exact relationship.
TimeoutStopSec=40m

# RuntimeDirectory owns the Unix socket's parent directory. The
# daemon binds AGENTCTLD_SOCKET_PATH inside it; the daemon resolves
# AGENTCTLD_SOCKET_GROUP and chowns the socket file (not the
# directory) to that group after creation.
#
# Mode 0750 limits traversal to the agentctld user/group. Operators
# who want to expose the socket to clients in a different group
# (e.g. a "agentctl-clients" group containing the OpenClaw
# sandbox) have two options:
#
#   1. Add the client group to SupplementaryGroups above and keep
#      RuntimeDirectoryMode=0750.
#   2. Widen RuntimeDirectoryMode=0755 (world-traversable); the
#      socket's mode 0660 + group ownership still gates actual
#      access. This is the standard pattern for socket services.
RuntimeDirectory=agentctld
RuntimeDirectoryMode=0750

# LogsDirectory owns the audit log directory. Point
# AGENTCTLD_AUDIT_LOG at /var/log/agentctld/audit.log so the file
# inherits the LogsDirectory ownership (agentctld:agentctld, 0750).
LogsDirectory=agentctld
LogsDirectoryMode=0750

# StateDirectory owns every persistent path the daemon writes to:
# source repository root, runtime repository root, deployment state,
# persistent app data, and managed Caddy fragments. Subdirectories
# are created by the daemon on first use; the operator does not
# need to pre-create them.
#
#   /var/lib/agentctl/state/    AGENTCTLD_STATE_DIR
#   /var/lib/agentctl/data/     AGENTCTLD_DATA_ROOT
#   /var/lib/agentctl/sources/  AGENTCTLD_SOURCE_REPOSITORY_ROOT
#                              AGENTCTLD_RUNTIME_REPOSITORY_ROOT
#   /var/lib/agentctl/caddy/    AGENTCTLD_CADDY_CONFIG_DIR
StateDirectory=agentctld
StateDirectoryMode=0750

# ConfigurationDirectory owns the EnvironmentFile above. Mode 0750
# is fine because systemd reads the file as root before exec.
ConfigurationDirectory=agentctld
ConfigurationDirectoryMode=0750

# Sandbox the daemon hard. Every directive below has been verified
# against the daemon's actual requirements (see
# docs/AGENTCTLD_INSTALL.md#hardening).
#
# agentctld does NOT need:
#   - privileged syscalls  (no mount, no unshare; Docker CLI is
#                            a thin client that talks to dockerd)
#   - namespaces           (no PID/IPC mount namespace creation;
#                            agentctld does not spawn containers)
#   - realtime scheduling  (no SCHED_FIFO/SCHED_RR)
#   - SUID/SGID            (no setuid/setgid binaries)
#   - /home, /root, /run/user (no home directory access)
#   - kernel tunables, modules, control groups
#   - kernel logs, clock, hostname writes
#   - raw block/character devices other than /dev/null etc.
#   - personality changes
#   - W^X memory           (no JIT; the audit logger does not need it)
#
# agentctld DOES need:
#   - AF_UNIX  (UDS listener)
#   - AF_INET, AF_INET6  (git fetch over HTTPS, loopback HTTP probes)
#   - read access to the canonical Caddyfile (typically /etc/caddy/Caddyfile)
#   - read/write access to /var/run/docker.sock (via docker group)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

# agentctld itself is small. The deploy pipeline spawns git, docker,
# and caddy as short-lived children whose resource usage is bounded
# by their own commands, not by this unit's cgroup. 512M is generous
# for the daemon process itself and provides defense-in-depth
# against runaway child accounting.
MemoryMax=512M

[Install]
WantedBy=multi-user.target