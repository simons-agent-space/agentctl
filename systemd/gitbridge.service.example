[Unit]
Description=gitbridge - GitHub App installation-token broker
Documentation=https://github.com/simons-agent-space/agentctl
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gitbridge
Group=gitbridge

ExecStart=/usr/local/bin/gitbridge \
    --config /etc/gitbridge/config.json \
    --log /var/log/gitbridge/audit.log

Restart=on-failure
RestartSec=5s

# Sandbox the broker hard. The only file descriptors it should hold
# are the UDS socket and the audit log.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem layout created by systemd.
ConfigurationDirectory=gitbridge
ConfigurationDirectoryMode=0750
LogsDirectory=gitbridge
LogsDirectoryMode=0750
RuntimeDirectory=gitbridge
RuntimeDirectoryMode=0750
StateDirectory=gitbridge

[Install]
WantedBy=multi-user.target